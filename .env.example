# /api/contact — need SMTP and/or Google Sheet webhook (at least one)

SMTP_HOST=smtp.example.com
SMTP_USER=
SMTP_PASS=

# Google Sheet "Website Leads Form" — deploy scripts/google-sheet-contact-webhook.gs
# then set these (same secret as Script property WEBHOOK_SECRET):
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_WEBHOOK_SECRET=
